[Unit]
Description=WeBuild public retrieval and freshness check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/webuild-monitor.env
ExecStart=/usr/bin/python3 /opt/webuild-monitor/healthcheck.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
